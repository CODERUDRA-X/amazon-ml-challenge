print("\nAggregating candidate_pairs.tsv and matching_results.tsv...")

def aggregate_to_dict(df, id_col, val_col):
    """Returns {s1_code: 'ID1,ID2,...'} using entity_id strings, deduped, no self-matches."""
    grouped = df.groupby(id_col)[val_col].apply(
        lambda x: ",".join(sorted(set(id_uniques[v] for v in x)))
    )
    return grouped.to_dict()

cand_map = aggregate_to_dict(candidates, "s1_id", "cand_id")
match_map = aggregate_to_dict(predicted, "s1_id", "cand_id")

# --- SUBSET-RULE SAFETY CHECK ---
# matched IDs must always be a subset of candidate IDs for the same S1 — guaranteed here
# because `predicted` is filtered FROM `candidates`, never generated independently.
# Extra guard in case of any drift:
def enforce_subset(cand_str, match_str):
    if not match_str:
        return match_str
    cand_set = set(cand_str.split(",")) if cand_str else set()
    match_set = set(match_str.split(","))
    kept = match_set & cand_set
    return ",".join(sorted(kept))

for s1_code in list(match_map.keys()):
    c = cand_map.get(s1_code, "")
    match_map[s1_code] = enforce_subset(c, match_map[s1_code])

