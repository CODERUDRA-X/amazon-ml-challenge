print("\nRunning quick self-validation...")

def quick_validate(cand_path, match_path, all_s1_ids):
    cand_df = pd.read_csv(cand_path, sep="\t", dtype=str, keep_default_na=False)
    match_df = pd.read_csv(match_path, sep="\t", dtype=str, keep_default_na=False)

    issues = []
    if set(cand_df["source1_entity_id"]) != set(all_s1_ids):
        issues.append("candidate_pairs.tsv S1 coverage mismatch")
    if set(match_df["source1_entity_id"]) != set(all_s1_ids):
        issues.append("matching_results.tsv S1 coverage mismatch")

    cand_lookup = dict(zip(cand_df["source1_entity_id"], cand_df["candidate_entity_ids"]))
    for _, row in match_df.iterrows():
        m_ids = set(row["matched_entity_ids"].split(",")) if row["matched_entity_ids"] else set()
        c_ids = set(cand_lookup.get(row["source1_entity_id"], "").split(",")) if cand_lookup.get(row["source1_entity_id"], "") else set()
        if not m_ids.issubset(c_ids):
            issues.append(f"Subset violation for {row['source1_entity_id']}")
            break  # don't spam

    if issues:
        print("⚠️ Issues found:", issues)
    else:
        print("✅ PASS — coverage complete, subset rule holds, no duplicates")

quick_validate(f"{out_dir}/candidate_pairs.tsv", f"{out_dir}/matching_results.tsv", ALL_S1_ENTITY_IDS)
