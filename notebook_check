def jaccard(a, b):
    sa, sb = set(str(a).lower().split()), set(str(b).lower().split())
    if not sa and not sb:
        return 1.0
    if not sa or not sb:
        return 0.0
    return len(sa & sb) / len(sa | sb)

def build_features(df, chunk_size=500_000):
    n = len(df)
    name_jaccard = np.zeros(n, dtype="float32")
    name_ratio = np.zeros(n, dtype="float32")
    addr_jaccard = np.zeros(n, dtype="float32")
    postal_match = np.zeros(n, dtype="float32")
    country_match = np.zeros(n, dtype="float32")

    s1_name = df["s1_business_name"].values
    r_name = df["r_business_name"].values
    s1_addr = df["s1_business_address"].values
    r_addr = df["r_business_address"].values
    s1_country = df["s1_country"].astype(str).str.lower().str.strip().values
    r_country = df["r_country"].astype(str).str.lower().str.strip().values

    postal_re = re.compile(r"(\d{5,6})")

    for start in range(0, n, chunk_size):
        end = min(start + chunk_size, n)
        for i in range(start, end):
            name_jaccard[i] = jaccard(s1_name[i], r_name[i])
            name_ratio[i] = fuzz.token_sort_ratio(str(s1_name[i]), str(r_name[i])) / 100.0
            addr_jaccard[i] = jaccard(s1_addr[i], r_addr[i])
            m1 = postal_re.search(str(s1_addr[i]))
            m2 = postal_re.search(str(r_addr[i]))
            postal_match[i] = 1.0 if (m1 and m2 and m1.group(1) == m2.group(1)) else 0.0
            country_match[i] = 1.0 if s1_country[i] == r_country[i] else 0.0
        if start % (chunk_size * 4) == 0:
            print(f"  features {end:,}/{n:,}")

    return pd.DataFrame({
        "name_jaccard": name_jaccard,
        "name_token_sort_ratio": name_ratio,
        "addr_jaccard": addr_jaccard,
        "postal_exact_match": postal_match,
        "country_exact_match": country_match,
    })

feature_cols = build_features(feat)
X_test = feature_cols[["name_jaccard", "name_token_sort_ratio", "addr_jaccard",
                        "postal_exact_match", "country_exact_match"]]

# =================================================================
# 7. PREDICT WITH TRAINED MODEL
# =================================================================
print("\nLoading trained model and predicting...")
model = joblib.load("/kaggle/working/xgb_matcher.pkl")  # <-- update path to your saved model

probs = model.predict_proba(X_test)[:, 1]
candidates["prob"] = probs.astype("float32")
