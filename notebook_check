# =================================================================
# 3. SAFE JOIN FUNCTION — identical to Stage 1F
# =================================================================
def safe_block_join(left, right, key_cols, tag):
    def get_valid(df):
        m = np.ones(len(df), dtype=bool)
        for c in key_cols:
            vals = df[c].fillna("").astype(str).str.strip()
            m &= (vals != "") & (vals.str.lower() != "nan") & (vals.str.lower() != "none")
        return df[m]

    left_v = get_valid(left)
    right_v = get_valid(right)

    if len(left_v) == 0 or len(right_v) == 0:
        return pd.DataFrame({"s1_id": pd.Series(dtype='int32'), "cand_id": pd.Series(dtype='int32')})

    lkey = left_v[key_cols].astype(str).agg("|".join, axis=1)
    rkey = right_v[key_cols].astype(str).agg("|".join, axis=1)

    combined = pd.concat([lkey, rkey], ignore_index=True)
    codes, _ = pd.factorize(combined)
    lcode = codes[:len(lkey)]
    rcode = codes[len(lkey):]

    l_ids, r_ids = left_v["id_code"].values, right_v["id_code"].values
    l_addr, r_addr = left_v["addr_pref"].values, right_v["addr_pref"].values
    l_namep, r_namep = left_v["name_pref"].values, right_v["name_pref"].values

    l_grp = pd.Series(l_ids).groupby(lcode).apply(lambda x: x.values)
    r_grp = pd.Series(r_ids).groupby(rcode).apply(lambda x: x.values)
    l_addr_grp = pd.Series(l_addr).groupby(lcode).apply(lambda x: x.values)
    r_addr_grp = pd.Series(r_addr).groupby(rcode).apply(lambda x: x.values)
    l_name_grp = pd.Series(l_namep).groupby(lcode).apply(lambda x: x.values)
    r_name_grp = pd.Series(r_namep).groupby(rcode).apply(lambda x: x.values)

    shared_keys = np.intersect1d(l_grp.index.values, r_grp.index.values)

    out_l, out_r = [], []
    explosive_keys, refined, tertiary, dropped = 0, 0, 0, 0

    for k in shared_keys:
        lv, rv = l_grp[k], r_grp[k]
        n1, n2 = len(lv), len(rv)

        if n1 * n2 <= MAX_DIRECT_PAIRS_PER_KEY:
            out_l.append(np.repeat(lv, n2)); out_r.append(np.tile(rv, n1))
            continue

        explosive_keys += 1
        la, ra = l_addr_grp[k], r_addr_grp[k]
        sub_l = pd.Series(lv).groupby(la).apply(lambda x: x.values)
        sub_r = pd.Series(rv).groupby(pd.Series(ra)).apply(lambda x: x.values)

        ln, rn = l_name_grp[k], r_name_grp[k]
        ln_map = dict(zip(lv, ln))
        rn_map = dict(zip(rv, rn))

        for sk in np.intersect1d(sub_l.index.values, sub_r.index.values):
            slv, srv = sub_l[sk], sub_r[sk]
            n1s, n2s = len(slv), len(srv)

            if n1s * n2s <= MAX_REFINED_PAIRS_PER_KEY:
                out_l.append(np.repeat(slv, n2s)); out_r.append(np.tile(srv, n1s))
                refined += n1s * n2s
                continue

            sln = np.array([ln_map[v] for v in slv])
            srn = np.array([rn_map[v] for v in srv])

            sub_l2 = pd.Series(slv).groupby(sln).apply(lambda x: x.values)
            sub_r2 = pd.Series(srv).groupby(pd.Series(srn)).apply(lambda x: x.values)

            for sk2 in np.intersect1d(sub_l2.index.values, sub_r2.index.values):
                slv2, srv2 = sub_l2[sk2], sub_r2[sk2]
                if len(slv2) * len(srv2) <= MAX_REFINED_PAIRS_PER_KEY:
                    out_l.append(np.repeat(slv2, len(srv2))); out_r.append(np.tile(srv2, len(slv2)))
                    tertiary += len(slv2) * len(srv2)
                else:
                    rng = np.random.default_rng(42)
                    capped = rng.choice(srv2, size=min(HARD_CAP_PER_S1, len(srv2)), replace=False)
                    out_l.append(np.repeat(slv2, len(capped))); out_r.append(np.tile(capped, len(slv2)))
                    dropped += len(slv2) * (len(srv2) - len(capped))

    s1_ids = np.concatenate(out_l) if out_l else np.array([], dtype="int32")
    cand_ids = np.concatenate(out_r) if out_r else np.array([], dtype="int32")

    print(f"[{tag}] shared={len(shared_keys):,} | expl={explosive_keys:,} | ref={refined:,} | tert={tertiary:,} | lost≈{dropped:,}")
    return pd.DataFrame({"s1_id": s1_ids, "cand_id": cand_ids})

