# =================================================================
# 1. LOAD & PREP — IDENTICAL to Stage 1F, no country filtering
#    (France flows through untouched — it's just another string value)
# =================================================================
def load_and_prep(filename, nrows=None):
    print(f"Loading {filename}...")
    df = pd.read_csv(f"{data_dir}/{filename}", sep="\t",
                      usecols=["entity_id", "business_name", "business_address", "country"],
                      dtype=str, nrows=nrows).fillna("")

    df["addr_pref"] = df["business_address"].str.replace(r"[^a-zA-Z0-9]", "", regex=True).str[:4].str.lower()
    name = df["business_name"].str.lower().str.replace(r"[^a-z0-9\s]", " ", regex=True).str.replace(r"\s+", " ", regex=True).str.strip()
    tokens = name.str.split()

    df["key_name1"] = tokens.str[0].fillna("")
    df["key_name2"] = tokens.str[:2].str.join(" ")
    df["key_postal"] = df["business_address"].str.extract(r"(\d{5,6})", expand=False).fillna("").astype(str)
    # NOTE: country is normalized (lower/strip) only for KEY MATCHING purposes.
    # It is NEVER filtered to a fixed set — France flows through exactly like US/India.
    df["country"] = df["country"].str.lower().str.strip()
    df["name_pref"] = df["business_name"].str.replace(r"[^a-zA-Z0-9]", "", regex=True).str[:3].str.lower()

    def extract_housenum(addr):
        m = re.search(r"\d+", str(addr))
        return m.group(0) if m else ""
    df["addr_housenum"] = df["business_address"].apply(extract_housenum)
    df["name_last_token"] = tokens.str[-1].fillna("")
    df["name_soundex"] = df["business_name"].apply(lambda x: jellyfish.soundex(str(x).split()[0]) if str(x).strip() else "")

    return df

s1 = load_and_prep("test_source1.tsv")
